generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  compilerBuild   = "small"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  country      Country            @default(CL)
  taxId        String             @unique
  plan         OrganizationPlan   @default(BASIC)
  status       OrganizationStatus @default(ACTIVE)
  monthlyFee   Float              @default(0)
  maxAdminHR   Int                @default(5)
  maxChiefs    Int                @default(0)
  maxStaff     Int                @default(0)
  nextPayment  DateTime?
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  users        User[]
  areas        Area[]
  invitations  OrganizationInvitation[]
  shiftTypes    ShiftType[]
  shifts        Shift[]
  rateTemplates RateTemplate[]
  contracts     Contract[]

  @@index([taxId])
  @@index([country])
  @@index([status])
  @@index([nextPayment])
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  country        Country?
  docType        DocType?
  docNumber      String?
  emailVerified  DateTime?
  image          String?
  role           Role          @default(STAFF_HEALTH)
  organizationId String?
  linkingCode    String        @unique @default(cuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       Account[]
  sessions       Session[]
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitations    OrganizationInvitation[]
  shifts         Shift[]
  contracts      Contract[]
  userAreas      UserArea[]

  @@unique([country, docType, docNumber])
  @@index([email])
  @@index([docNumber])
  @@index([linkingCode])
  @@index([organizationId])
  @@index([country])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  SUPER_ADMIN
  ADMIN_HR
  CHIEF_AREA
  STAFF_HEALTH
}

enum Country {
  CL
  PE
  CO
  AR
  MX
  US
}

enum DocType {
  RUT
  CC
  CE
  TI
  DNI
  CARNET_EXT
  DNI_AR
  CUIL
  CUIT
  CURP
  RFC
  PASSPORT
}

enum OrganizationPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  PENDING_PAYMENT
  SUSPENDED
  INACTIVE
}

enum BaseSalaryUnit {
  MONTHLY
  DAILY
  HOURLY
}

model RateTemplate {
  id              String          @id @default(cuid())
  name            String
  description     String?
  ratePerMinute   Float
  ratePerHour     Float?
  baseSalary      Float?
  baseSalaryUnit  BaseSalaryUnit?
  isActive        Boolean         @default(true)
  organizationId  String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts       Contract[]

  @@index([organizationId])
  @@index([isActive])
}

model Contract {
  id                 String          @id @default(cuid())
  userId             String
  organizationId     String
  areaId             String?
  rateTemplateId     String?
  ratePerMinute      Float?
  adjustmentPerMinute Float           @default(0)
  baseSalary         Float?
  baseSalaryUnit     BaseSalaryUnit?
  startDate          DateTime        @default(now())
  endDate            DateTime?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area               Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  rateTemplate       RateTemplate?   @relation(fields: [rateTemplateId], references: [id], onDelete: SetNull)
  shifts             Shift[]

  @@index([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([areaId])
}

model Area {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  icon                 String?         @default("Building2")
  color                String          @default("#3b82f6")
  isActive             Boolean         @default(false)
  maxConsecutiveHours  Int?
  minRestHours         Int?
  organizationId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts         Shift[]
  contracts      Contract[]
  shiftTypes     AreaShiftType[]
  userAreas      UserArea[]

  @@index([organizationId])
  @@index([isActive])
}

model UserArea {
  userId   String
  areaId   String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area     Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@index([userId])
  @@index([areaId])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  status         InvitationStatus @default(PENDING)
  invitedBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, role])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ShiftClassification {
  DAY
  NIGHT
  MIXED
}

model ShiftType {
  id                String             @id @default(cuid())
  name              String
  description       String?
  icon              String?            @default("Clock")
  durationMinutes   Int                @default(480)
  classification    ShiftClassification @default(DAY)
  color             String             @default("#3b82f6")
  minStaffRequired  Int                @default(1)
  idealStaffCount   Int                @default(1)
  maxStaffAllowed   Int                @default(10)
  suggestedRestDays Int                @default(1)
  isGlobal          Boolean            @default(true)
  isActive          Boolean            @default(true)
  organizationId    String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  areaShiftTypes    AreaShiftType[]

  @@index([organizationId])
  @@index([isActive])
}

model AreaShiftType {
  areaId      String
  shiftTypeId String
  isActive    Boolean   @default(true)
  area        Area      @relation(fields: [areaId], references: [id], onDelete: Cascade)
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@id([areaId, shiftTypeId])
  @@index([areaId])
  @@index([shiftTypeId])
}

model Shift {
  id            String     @id @default(cuid())
  title         String?
  startTime     DateTime
  endTime       DateTime
  status        ShiftStatus @default(SCHEDULED)
  notes         String?
  userId        String
  areaId        String
  shiftTypeId   String
  organizationId String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  area          Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  shiftType     ShiftType  @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId    String?

  contract      Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([contractId])
  @@index([areaId])
  @@index([shiftTypeId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
