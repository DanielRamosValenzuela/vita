generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String                   @id @default(cuid())
  name          String
  country       Country                  @default(CL)
  currency      Currency                 @default(CLP)
  taxId         String                   @unique
  plan          OrganizationPlan         @default(BASIC)
  status        OrganizationStatus       @default(ACTIVE)
  monthlyFee    Float                    @default(0)
  maxAdminHR    Int                      @default(5)
  maxChiefs     Int                      @default(0)
  maxStaff      Int                      @default(0)
  nextPayment   DateTime?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  users         User[]
  areas         Area[]
  invitations   OrganizationInvitation[]
  shiftTypes    ShiftType[]
  shifts        Shift[]
  rateTemplates RateTemplate[]
  contracts      Contract[]
  calendars      OrganizationCalendar[]
  notifications  Notification[]

  @@index([taxId])
  @@index([country])
  @@index([status])
  @@index([nextPayment])
}

model User {
  id              String                   @id @default(cuid())
  email           String                   @unique
  name            String
  country         Country?
  docType         DocType?
  docNumber       String?
  emailVerified   DateTime?
  image           String?
  customImage     String?
  imageProvider   ImageProvider?
  role            Role                     @default(STAFF_HEALTH)
  organizationId  String?
  linkingCode     String                   @unique @default(cuid())
  phone           String?
  address         String?
  additionalInfo  String?
  birthDate       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  accounts        Account[]
  sessions        Session[]
  organization    Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitations     OrganizationInvitation[]
  shifts          Shift[]
  contracts       Contract[]
  userAreas       UserArea[]
  emails                UserEmail[]
  documentHistory       UserDocumentHistory[]
  notificationsReceived Notification[]         @relation("NotificationRecipient")
  notificationsActed    Notification[]         @relation("NotificationActor")

  @@index([email])
  @@index([docNumber])
  @@index([linkingCode])
  @@index([organizationId])
  @@index([country])
}

model UserEmail {
  id         String         @id @default(cuid())
  userId     String
  email      String         @unique
  isPrimary  Boolean        @default(false)
  isVerified Boolean        @default(false)
  provider   EmailProvider?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model UserDocumentHistory {
  id           String    @id @default(cuid())
  userId       String
  country      Country
  docType      DocType
  docNumber    String
  validFrom    DateTime  @default(now())
  validUntil   DateTime?
  changeReason String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([docNumber])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  SUPER_ADMIN
  ADMIN_HR
  CHIEF_AREA
  STAFF_HEALTH
}

enum Country {
  CL
  PE
  CO
  AR
  MX
  US
}

enum DocType {
  RUT
  CC
  CE
  TI
  DNI
  CARNET_EXT
  DNI_AR
  CUIL
  CUIT
  CURP
  RFC
  PASSPORT
}

enum OrganizationPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  PENDING_PAYMENT
  SUSPENDED
  INACTIVE
}

enum Currency {
  CLP
  USD
  COP
  ARS
  MXN
  PEN
  EUR
}

enum ComponentType {
  BASE_SALARY
  PER_MINUTE
  PER_HOUR
  PER_SHIFT
  SHIFT_COMPLETION_BONUS
  NIGHT_SHIFT_BONUS
  WEEKEND_BONUS
  HOLIDAY_BONUS
  WEEKEND_MULTIPLIER
  HOLIDAY_MULTIPLIER
  IRRENUNCIABLE_MULTIPLIER
  NIGHT_MULTIPLIER
  OVERTIME_MULTIPLIER
  SENIORITY_BONUS
  PERFORMANCE_BONUS
  AREA_BONUS
  EMERGENCY_BONUS
  ON_CALL_BONUS
  CUSTOM
}

enum ComponentUnit {
  MONTHLY
  BIWEEKLY
  WEEKLY
  DAILY
  PER_SHIFT
  PER_MINUTE
  PER_HOUR
  PERCENTAGE
  MULTIPLIER
  FIXED_AMOUNT
}

enum ApplyCondition {
  ALWAYS
  WEEKDAY_ONLY
  WEEKEND_ONLY
  SATURDAY_ONLY
  SUNDAY_ONLY
  HOLIDAY_ONLY
  IRRENUNCIABLE_ONLY
  OVERTIME_ONLY
  SPECIFIC_AREA
  SPECIFIC_SHIFT_TYPE
  CUSTOM_RULE
}

model RateTemplate {
  id             String          @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean         @default(true)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  components     RateComponent[]
  contracts      Contract[]

  @@index([organizationId])
  @@index([isActive])
}

model RateComponent {
  id                      String                        @id @default(cuid())
  rateTemplateId          String
  type                    ComponentType
  customName              String?
  value                   Float
  unit                    ComponentUnit
  applyCondition          ApplyCondition                @default(ALWAYS)
  conditionValue          String?
  description             String?
  order                   Int                           @default(0)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  rateTemplate            RateTemplate                  @relation(fields: [rateTemplateId], references: [id], onDelete: Cascade)
  applicableShiftTypes    RateComponentApplicableType[]
  shiftPaymentBreakdowns  ShiftPaymentBreakdown[]

  @@index([rateTemplateId])
  @@index([type])
  @@index([applyCondition])
}

model RateComponentApplicableType {
  rateComponentId String
  shiftTypeId     String
  rateComponent   RateComponent @relation(fields: [rateComponentId], references: [id], onDelete: Cascade)
  shiftType       ShiftType     @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@id([rateComponentId, shiftTypeId])
  @@index([rateComponentId])
  @@index([shiftTypeId])
}

model Contract {
  id               String       @id @default(cuid())
  userId           String
  organizationId   String
  areaId           String?
  rateTemplateId   String
  customMultiplier Float?
  startDate        DateTime     @default(now())
  endDate          DateTime?
  isActive         Boolean      @default(true)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area             Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  rateTemplate     RateTemplate @relation(fields: [rateTemplateId], references: [id], onDelete: Restrict)
  shifts           Shift[]

  @@index([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([areaId])
  @@index([rateTemplateId])
  @@index([isActive])
}

enum DayType {
  NORMAL
  WEEKEND
  SATURDAY
  SUNDAY
  HOLIDAY
  IRRENUNCIABLE
  ORGANIZATION_HOLIDAY
  CUSTOM
}

model OrganizationCalendar {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime
  type           DayType      @default(NORMAL)
  name           String?
  description    String?
  multiplier     Float        @default(1.0)
  isRecurring    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
  @@index([type])
}

model Area {
  id                  String          @id @default(cuid())
  name                String
  description         String?
  icon                String?         @default("Building2")
  color               String          @default("#3b82f6")
  isActive            Boolean         @default(false)
  maxConsecutiveHours Int?
  minRestHours        Int?
  dayStartTime        String?
  dayEndTime          String?
  organizationId      String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts              Shift[]
  contracts           Contract[]
  shiftTypes          AreaShiftType[]
  userAreas           UserArea[]

  @@index([organizationId])
  @@index([isActive])
}

model UserArea {
  userId String
  areaId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@index([userId])
  @@index([areaId])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  status         InvitationStatus @default(PENDING)
  invitedBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  acceptedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, role])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ShiftClassification {
  DAY
  NIGHT
  MIXED
}

model ShiftType {
  id                        String                        @id @default(cuid())
  name                      String
  description               String?
  icon                      String?                       @default("Clock")
  durationMinutes           Int                           @default(480)
  classification            ShiftClassification           @default(DAY)
  color                     String                        @default("#3b82f6")
  minStaffRequired          Int                           @default(1)
  idealStaffCount           Int                           @default(1)
  maxStaffAllowed           Int                           @default(10)
  suggestedRestDays         Int                           @default(1)
  isGlobal                  Boolean                       @default(true)
  isActive                  Boolean                       @default(true)
  organizationId            String
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  organization              Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts                    Shift[]
  areaShiftTypes            AreaShiftType[]
  applicableRateComponents  RateComponentApplicableType[]

  @@index([organizationId])
  @@index([isActive])
}

model AreaShiftType {
  areaId      String
  shiftTypeId String
  isActive    Boolean   @default(true)
  area        Area      @relation(fields: [areaId], references: [id], onDelete: Cascade)
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@id([areaId, shiftTypeId])
  @@index([areaId])
  @@index([shiftTypeId])
}

model Shift {
  id              String         @id @default(cuid())
  title           String?
  startTime       DateTime
  endTime         DateTime
  actualStartTime DateTime?
  actualEndTime   DateTime?
  status          ShiftStatus    @default(SCHEDULED)
  notes           String?
  userId          String
  areaId          String
  shiftTypeId     String
  organizationId  String
  contractId      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  area            Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  shiftType       ShiftType      @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract        Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  payment         ShiftPayment?

  @@index([organizationId])
  @@index([userId])
  @@index([contractId])
  @@index([areaId])
  @@index([shiftTypeId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([actualStartTime])
  @@index([actualEndTime])
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  CALCULATED
  APPROVED
  PAID
  DISPUTED
}

model ShiftPayment {
  id                    String                  @id @default(cuid())
  shiftId               String                  @unique
  totalAmount           Float
  baseAmount            Float
  calendarMultiplier    Float                   @default(1.0)
  finalAmount           Float
  minutesWorked         Int
  isPartialCompletion   Boolean                 @default(false)
  status                PaymentStatus           @default(PENDING)
  calculatedAt          DateTime                @default(now())
  approvedAt            DateTime?
  approvedBy            String?
  paidAt                DateTime?
  notes                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  shift                 Shift                   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  breakdowns            ShiftPaymentBreakdown[]

  @@index([shiftId])
  @@index([status])
  @@index([calculatedAt])
  @@index([paidAt])
}

model ShiftPaymentBreakdown {
  id              String        @id @default(cuid())
  shiftPaymentId  String
  componentId     String
  componentName   String
  componentType   ComponentType
  baseValue       Float
  calculatedValue Float
  appliedMinutes  Int?
  notes           String?
  createdAt       DateTime      @default(now())
  shiftPayment    ShiftPayment  @relation(fields: [shiftPaymentId], references: [id], onDelete: Cascade)
  component       RateComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([shiftPaymentId])
  @@index([componentId])
}

enum ImageProvider {
  OAUTH
  UPLOAD
  GRAVATAR
}

enum EmailProvider {
  GOOGLE
  CREDENTIALS
  GITHUB
  FACEBOOK
  APPLE
}

enum NotificationType {
  INVITATION_PENDING
  AREA_ASSIGNED
  SHIFT_CREATED
  SHIFT_UPDATED
  SHIFT_CANCELLED
  GENERAL
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  actorId        String?
  organizationId String?
  type           NotificationType
  title          String
  description    String?
  actionUrl      String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user         User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
}
